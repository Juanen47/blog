---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// Activo si la página actual está bajo esa sección (/blog/ cubre también /blog/<slug>/).
const section = (path: string) => path.split('/').filter(Boolean)[0] ?? '';
const isActive = section(String(href)) === section(Astro.url.pathname);
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
  <slot />
</a>

<style>
  a {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
  }

  a:hover {
    color: var(--text);
    text-decoration: none;
  }

  a.active {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
</style>
