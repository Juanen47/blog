---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// Activo si la página actual está bajo esa sección (/blog/ cubre también /blog/<slug>/).
const section = (path: string) => path.split('/').filter(Boolean)[0] ?? '';
const isActive = section(String(href)) === section(Astro.url.pathname);
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
  <slot />
</a>

<style>
  a {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    padding-block: 0.4rem;
    background: linear-gradient(var(--accent), var(--accent)) no-repeat left bottom / 0 2px;
    transition: color 0.2s, background-size 0.3s var(--ease-out);
  }

  a:hover { color: var(--text); background-size: 100% 2px; }
  a.active { color: var(--text); background-size: 100% 2px; }
</style>
