---
import HeaderLink from './HeaderLink.astro';
---

<a href="#main" class="skip-link">Saltar al contenido</a>
<header>
  <nav>
    <a href="https://jelopez.link" class="logo">JELOPEZ<span>.</span>LINK</a>
    <div class="nav-links">
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/about">Sobre mí</HeaderLink>
      <button id="translate-btn" class="translate-btn" title="Translate to English">EN</button>
    </div>
  </nav>
</header>

<style>
  header {
    margin: 0;
    padding: 0 2rem;
    background: rgba(11, 11, 13, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    max-width: 900px;
    margin: 0 auto;
  }

  .logo {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.15em;
    color: var(--text);
    text-decoration: none;
  }

  .logo:hover { text-decoration: none; }
  .logo span { color: var(--accent); }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .translate-btn {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }

  .translate-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .translate-btn:disabled {
    opacity: 0.4;
    cursor: wait;
  }

  @media (max-width: 640px) {
    header { padding: 0 1.25rem; }
    .nav-links { gap: 1rem; }
    .translate-btn { display: none; }
  }
</style>
