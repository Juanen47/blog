---
import type { CollectionEntry } from 'astro:content';
import { readingTime, tagSlug } from '../utils';

interface Props {
  posts: CollectionEntry<'blog'>[];
  headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel: H = 'h2' } = Astro.props;
---

<ol class="post-list">
  {posts.map((post) => (
    <li class="post">
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
      <div class="post-body">
        <H class="post-title"><a href={`/blog/${post.id}/`} style={`view-transition-name: t-${post.id}`}>{post.data.title}</a></H>
        <p>{post.data.description}</p>
        <div class="post-meta">
          <span>{readingTime(post.body)} min de lectura</span>
          {post.data.tags && (
            <ul class="post-tags" aria-label="Etiquetas">
              {post.data.tags.slice(0, 3).map((tag: string) => (
                <li><a class="tag" href={`/etiquetas/${tagSlug(tag)}/`}>{tag}</a></li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </li>
  ))}
</ol>

<style>
  .post-list { list-style: none; padding: 0; }

  .post {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--line);
  }

  .post:last-child { border-bottom: 1px solid var(--line); }

  time {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2rem;
  }

  .post-body { max-width: 44rem; }

  .post-title {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.45rem;
  }

  .post-title a {
    color: var(--text);
    text-decoration: none;
    background: linear-gradient(var(--accent), var(--accent)) no-repeat left 100% / 0 2px;
    transition: color 0.2s, background-size 0.35s var(--ease-out);
  }

  /* Toda la fila es clicable sin anidar enlaces */
  .post-title a::after { content: ''; position: absolute; inset: 0; }

  .post:hover .post-title a { color: var(--accent); background-size: 100% 2px; }

  p { font-size: 0.98rem; line-height: 1.6; color: var(--text-2); }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .post-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; padding: 0; }

  /* Las etiquetas quedan por encima del enlace de la fila */
  .post-tags a { position: relative; z-index: 1; }

  @media (max-width: 640px) {
    .post { grid-template-columns: 1fr; gap: 0.35rem; padding: 1.3rem 0; }
    .post-title { font-size: 1.15rem; }
  }
</style>
