---
import { SITE } from '../consts';

const today = new Date();
---

<footer>
  <div class="wrap">
    <p>© {today.getFullYear()} {SITE.author}</p>
    <ul class="footer-links">
      <li><a href={SITE.web} rel="me">jelopez.link</a></li>
      <li><a href={SITE.github} rel="me noopener">GitHub</a></li>
      <li><a href={SITE.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a href={`mailto:${SITE.email}`}>Email</a></li>
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href="/privacidad/">Privacidad y cookies</a></li>
    </ul>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 2rem var(--gutter) 2.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    max-width: calc(var(--wrap) - 2 * var(--gutter));
    margin: 0 auto;
  }

  p { color: var(--muted); }

  .footer-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; list-style: none; }
  .footer-links a { color: var(--text-2); text-decoration: none; }
  .footer-links a:hover { color: var(--accent); }

  @media (max-width: 640px) {
    .wrap { flex-direction: column; }
  }
</style>
