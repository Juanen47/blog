---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: MarkdownHeading[];
  readingTime?: number;
};

const { title, description, pubDate, updatedDate, tags, headings = [], readingTime } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <div class="post-layout">
        <article>
          <div class="post-header">
            <div class="post-date">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <span class="updated">· Actualizado: <FormattedDate date={updatedDate} /></span>
              )}
              {readingTime && <span>· {readingTime} min de lectura</span>}
            </div>
            <h1>{title}</h1>
            <p class="post-description">{description}</p>
            {tags && (
              <div class="tags">
                {tags.map((tag: string) => <span class="tag">{tag}</span>)}
              </div>
            )}
            <button id="translate-btn-mobile" class="translate-btn-mobile">EN</button>
            <hr />
          </div>
          <div class="prose" id="post-content">
            <slot />
          </div>
          <Comments />
        </article>
        {toc.length > 2 && (
          <aside class="toc" aria-label="Tabla de contenidos">
            <p class="toc-title">En esta página</p>
            <ul>
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'sub' : undefined}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>

<script>
  // Barra de progreso de lectura
  const bar = document.getElementById('progress');
  function updateProgress() {
    if (!bar) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // Enlaces ancla en h2/h3 y botón "copiar" en los bloques de código
  document.querySelectorAll<HTMLElement>('#post-content :is(h2, h3)[id]').forEach((h) => {
    const a = document.createElement('a');
    a.href = `#${h.id}`;
    a.className = 'heading-anchor';
    a.textContent = '#';
    a.setAttribute('aria-label', 'Enlace a esta sección');
    h.prepend(a);
  });

  document.querySelectorAll<HTMLElement>('#post-content pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copiar';
    pre.appendChild(btn);
  });

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy-btn');
    if (!btn) return;
    const code = btn.parentElement?.querySelector('code')?.innerText ?? '';
    try {
      await navigator.clipboard.writeText(code);
      btn.textContent = 'Copiado';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = 'Copiar';
        btn.classList.remove('copied');
      }, 1800);
    } catch {
      btn.textContent = 'Error';
    }
  });

  const btnDesktop = document.getElementById('translate-btn') as HTMLButtonElement;
  const btnMobile = document.getElementById('translate-btn-mobile') as HTMLButtonElement;
  const content = document.getElementById('post-content');

  let translated = false;
  let originalHTML = '';
  let originalH1 = '';
  let originalDesc = '';

  function setButtonState(text: string, disabled: boolean) {
    if (btnDesktop) { btnDesktop.textContent = text; btnDesktop.disabled = disabled; }
    if (btnMobile) { btnMobile.textContent = text; btnMobile.disabled = disabled; }
  }

  function extractTextNodes(root: Node): Text[] {
    const nodes: Text[] = [];
    const skip = ['CODE', 'PRE', 'SVG', 'SCRIPT', 'STYLE'];

    function walk(node: Node) {
      if (node.nodeType === Node.TEXT_NODE) {
        const text = node.textContent?.trim();
        if (text && text.length > 2) nodes.push(node as Text);
      } else if (node.nodeType === Node.ELEMENT_NODE) {
        if (skip.includes((node as Element).tagName)) return;
        for (const child of Array.from(node.childNodes)) walk(child);
      }
    }
    walk(root);
    return nodes;
  }

  function chunkText(texts: string[], maxLen = 300): string[][] {
    const chunks: string[][] = [];
    let current: string[] = [];
    let currentLen = 0;

    for (const text of texts) {
      if (currentLen + text.length > maxLen) {
        if (current.length) chunks.push(current);
        current = [text];
        currentLen = text.length;
      } else {
        current.push(text);
        currentLen += text.length;
      }
    }
    if (current.length) chunks.push(current);
    return chunks;
  }

  async function translateChunk(texts: string[]): Promise<string[]> {
    const joined = texts.join('\n||||\n');
    const res = await fetch(
      `https://api.mymemory.translated.net/get?q=${encodeURIComponent(joined)}&langpair=es|en&de=juanenlopez1459@gmail.com`
    );
    const data = await res.json();
    const result = data.responseData.translatedText as string;
    return result.split('\n||||\n');
  }

  async function handleTranslate() {
    if (!content) return;

    const h1 = document.querySelector('h1');
    const desc = document.querySelector('.post-description');

    if (!translated) {
      setButtonState('...', true);

      originalHTML = content.innerHTML;
      originalH1 = h1?.textContent || '';
      originalDesc = desc?.textContent || '';

      try {
        const areas = [h1, desc, content].filter(Boolean) as Node[];
        const nodes = areas.flatMap(el => extractTextNodes(el));
        const texts = nodes.map(n => n.textContent || '');
        const chunks = chunkText(texts);

        const results = await Promise.all(chunks.map(translateChunk));
        const flat = results.flat();

        nodes.forEach((node, i) => {
          if (flat[i]) node.textContent = flat[i];
        });

        setButtonState('ES', false);
        translated = true;
      } catch {
        content.innerHTML = originalHTML;
        if (h1) h1.textContent = originalH1;
        if (desc) desc.textContent = originalDesc;
        setButtonState('EN', false);
      }
    } else {
      content.innerHTML = originalHTML;
      if (h1) h1.textContent = originalH1;
      if (desc) desc.textContent = originalDesc;
      setButtonState('EN', false);
      translated = false;
    }
  }

  btnDesktop?.addEventListener('click', handleTranslate);
  btnMobile?.addEventListener('click', handleTranslate);
</script>

<style>
  main {
    max-width: 1080px;
  }

  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 300;
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 720px) 220px;
    gap: 3.5rem;
    justify-content: center;
  }

  article { min-width: 0; }

  .post-header { margin-bottom: 2rem; }

  .post-date {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .post-date time { font-family: var(--font-mono); }

  h1 {
    font-size: 2.4rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .post-description {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    background: var(--surface-hover);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }

  .translate-btn-mobile {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    margin-top: 1rem;
  }

  .translate-btn-mobile:hover { border-color: var(--accent); color: var(--accent); }
  .translate-btn-mobile:disabled { opacity: 0.4; cursor: wait; }

  hr { margin: 1.75rem 0 2rem; }

  .prose { font-size: 1rem; line-height: 1.8; }

  /* Tabla de contenidos */
  .toc {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    font-size: 0.82rem;
  }

  .toc-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .toc ul {
    list-style: none;
    padding: 0 0 0 0.9rem;
    margin: 0;
    border-left: 1px solid var(--border);
  }

  .toc li { margin: 0 0 0.45rem; line-height: 1.4; }
  .toc li.sub { padding-left: 0.8rem; }

  .toc a { color: var(--text-muted); transition: color 0.15s; }
  .toc a:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 1100px) {
    .post-layout { grid-template-columns: minmax(0, 720px); }
    .toc { display: none; }
  }

  @media (max-width: 640px) {
    h1 { font-size: 1.7rem; }
    .translate-btn-mobile { display: block; }
  }
</style>