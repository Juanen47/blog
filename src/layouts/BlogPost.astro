---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_LD, SITE } from '../consts';
import { tagSlug } from '../utils';

interface PostLink { href: string; title: string }

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: MarkdownHeading[];
  readingTime?: number;
  wordCount?: number;
  newer?: PostLink;
  older?: PostLink;
};

const { title, description, pubDate, updatedDate, heroImage, tags, headings = [], readingTime, wordCount, newer, older } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const slug = Astro.url.pathname.split('/').filter(Boolean).pop() ?? '';
const url = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${url}#post`,
      headline: title,
      description,
      url,
      mainEntityOfPage: url,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate ?? pubDate).toISOString(),
      inLanguage: 'es-ES',
      keywords: tags?.join(', '),
      wordCount,
      image: new URL(heroImage?.src ?? '/og.png', Astro.site).href,
      author: AUTHOR_LD,
      publisher: { '@id': AUTHOR_LD['@id'] },
      isPartOf: { '@type': 'Blog', '@id': `${SITE.url}/#blog`, name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Blog', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Artículos', item: `${SITE.url}/blog/` },
        { '@type': 'ListItem', position: 3, name: title, item: url },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={`${title} · jelopez.link`}
      description={description}
      image={heroImage}
      type="article"
      publishedTime={pubDate}
      modifiedTime={updatedDate}
      tags={tags}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <div class="post-layout">
        <article>
          <header class="post-header">
            <nav class="breadcrumb" aria-label="Ruta">
              <a href="/blog/">Artículos</a> <span aria-hidden="true">/</span>
            </nav>
            <h1 style={`view-transition-name: t-${slug}`}>{title}</h1>
            <p class="post-description">{description}</p>
            <div class="post-meta">
              <span><FormattedDate date={pubDate} /></span>
              {updatedDate && (
                <span>Actualizado el <FormattedDate date={updatedDate} /></span>
              )}
              {readingTime && <span>{readingTime} min de lectura</span>}
            </div>
            {tags && (
              <ul class="tags" aria-label="Etiquetas">
                {tags.map((tag: string) => <li><a class="tag" href={`/etiquetas/${tagSlug(tag)}/`}>{tag}</a></li>)}
              </ul>
            )}
          </header>
          {heroImage && <Image class="hero-image" src={heroImage} alt="" widths={[720, 1440]} sizes="(max-width: 760px) 100vw, 720px" loading="eager" />}
          <div class="prose" id="post-content">
            <slot />
          </div>
          <aside class="author-box" aria-label="Sobre el autor">
            <div class="avatar" aria-hidden="true">JL</div>
            <div>
              <p class="author-name">{SITE.author}</p>
              <p>Administrador de sistemas y redes en Albacete, especializado en ciberseguridad. Documento aquí lo que monto en mi homelab.</p>
              <p class="author-links">
                <a href="/about/">Sobre mí</a>
                <a href={SITE.web}>jelopez.link</a>
                <a href={SITE.linkedin} rel="noopener">LinkedIn</a>
              </p>
            </div>
          </aside>
          {(newer || older) && (
            <nav class="post-nav" aria-label="Más artículos">
              {older ? (
                <a href={older.href} class="prev" rel="prev"><span>Anterior</span>{older.title}</a>
              ) : <span />}
              {newer && (
                <a href={newer.href} class="next" rel="next"><span>Siguiente</span>{newer.title}</a>
              )}
            </nav>
          )}
          <Comments />
        </article>
        {toc.length > 2 && (
          <aside class="toc" aria-label="Tabla de contenidos">
            <p class="toc-title">En esta página</p>
            <ul>
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'sub' : undefined}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>

<script>
  // Barra de progreso de lectura
  const bar = document.getElementById('progress');
  function updateProgress() {
    if (!bar) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // Tabla de contenidos: marca la sección que se está leyendo
  const tocLinks = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]').forEach((a) => {
    tocLinks.set(decodeURIComponent(a.hash.slice(1)), a);
  });
  if (tocLinks.size && 'IntersectionObserver' in window) {
    const visible = new Set<string>();
    const order = [...tocLinks.keys()];
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
        const current = order.find((id) => visible.has(id));
        if (!current) return;
        tocLinks.forEach((a, id) => a.classList.toggle('active', id === current));
      },
      { rootMargin: '-72px 0px -65% 0px' },
    );
    order.forEach((id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }

  // Enlaces ancla en h2/h3 y botón "copiar" en los bloques de código
  document.querySelectorAll<HTMLElement>('#post-content :is(h2, h3)[id]').forEach((h) => {
    const a = document.createElement('a');
    a.href = `#${h.id}`;
    a.className = 'heading-anchor';
    a.textContent = '#';
    a.setAttribute('aria-label', 'Enlace a esta sección');
    h.prepend(a);
  });

  document.querySelectorAll<HTMLElement>('#post-content pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copiar';
    pre.appendChild(btn);
  });

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy-btn');
    if (!btn) return;
    const code = btn.parentElement?.querySelector('code')?.innerText ?? '';
    try {
      await navigator.clipboard.writeText(code);
      btn.textContent = 'Copiado';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = 'Copiar';
        btn.classList.remove('copied');
      }, 1800);
    } catch {
      btn.textContent = 'Error';
    }
  });
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 300;
    view-transition-name: progress;
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 46rem) 15rem;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    justify-content: space-between;
  }

  article { min-width: 0; }

  .post-header {
    padding-bottom: 2rem;
    margin-bottom: 2.25rem;
    border-bottom: 1px solid var(--line);
  }

  .breadcrumb { font-size: 0.92rem; margin-bottom: 1rem; color: var(--muted); }
  .breadcrumb a { color: var(--text-2); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }

  h1 {
    font-size: clamp(1.9rem, 3.9vw, 2.8rem);
    font-stretch: 112%;
    line-height: 1.05;
    margin-bottom: 1rem;
    max-width: 26ch;
  }

  .post-description {
    font-size: clamp(1.08rem, 1.6vw, 1.22rem);
    line-height: 1.55;
    color: var(--text-2);
    max-width: 60ch;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0;
    margin-top: 1.4rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .post-meta span + span::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 0.9em;
    margin: 0 0.85rem;
    vertical-align: -0.1em;
    background: var(--line-strong);
  }

  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; list-style: none; padding: 0; margin-top: 1rem; }

  .hero-image { width: 100%; margin-bottom: 2rem; border-radius: var(--radius); }

  .author-box {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin-top: 3.5rem;
    padding: 1.4rem 1.5rem;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--text);
    color: var(--bg);
    font-weight: 800;
    font-stretch: var(--wide);
    position: relative;
  }

  .avatar::after {
    content: '';
    position: absolute;
    right: 0.45rem;
    bottom: 0.45rem;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--accent);
  }

  .author-box p { font-size: 0.95rem; }
  .author-box .author-name { font-weight: 650; color: var(--text); margin-bottom: 0.2rem; }
  .author-box .author-links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; margin-top: 0.6rem; font-size: 0.92rem; font-weight: 600; }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .post-nav a {
    display: block;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raised);
    color: var(--text);
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.4;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .post-nav a:hover { border-color: var(--accent); color: var(--accent); }
  .post-nav span { display: block; font-size: 0.82rem; font-weight: 500; color: var(--muted); margin-bottom: 0.3rem; }
  .post-nav .next { text-align: right; }

  /* Tabla de contenidos */
  .toc {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    font-size: 0.9rem;
    padding-top: 0.35rem;
  }

  .toc-title { font-weight: 700; font-stretch: var(--wide); color: var(--text); margin-bottom: 0.75rem; }

  .toc ul { list-style: none; padding: 0; margin: 0; border-left: 1px solid var(--line); }
  .toc li { margin: 0; line-height: 1.35; }
  .toc li.sub a { padding-left: 1.6rem; font-size: 0.86rem; }

  .toc a {
    display: block;
    padding: 0.32rem 0 0.32rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }

  .toc a:hover { color: var(--text); }
  .toc a.active { color: var(--text); border-left-color: var(--accent); font-weight: 600; }

  @media (max-width: 1100px) {
    .post-layout { grid-template-columns: minmax(0, 46rem); justify-content: center; }
    .toc { display: none; }
  }

  @media (max-width: 640px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-nav .next { text-align: left; }
    .author-box { flex-direction: column; }
  }
</style>
