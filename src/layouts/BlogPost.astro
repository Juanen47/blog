---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_LD, SITE } from '../consts';
import { tagSlug } from '../utils';

interface PostLink { href: string; title: string }

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: MarkdownHeading[];
  readingTime?: number;
  wordCount?: number;
  newer?: PostLink;
  older?: PostLink;
};

const { title, description, pubDate, updatedDate, heroImage, tags, headings = [], readingTime, wordCount, newer, older } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const url = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${url}#post`,
      headline: title,
      description,
      url,
      mainEntityOfPage: url,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate ?? pubDate).toISOString(),
      inLanguage: 'es-ES',
      keywords: tags?.join(', '),
      wordCount,
      image: new URL(heroImage?.src ?? '/og.png', Astro.site).href,
      author: AUTHOR_LD,
      publisher: { '@id': AUTHOR_LD['@id'] },
      isPartOf: { '@type': 'Blog', '@id': `${SITE.url}/#blog`, name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Blog', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Artículos', item: `${SITE.url}/blog/` },
        { '@type': 'ListItem', position: 3, name: title, item: url },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={`${title} · jelopez.link`}
      description={description}
      image={heroImage}
      type="article"
      publishedTime={pubDate}
      modifiedTime={updatedDate}
      tags={tags}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <div class="post-layout">
        <article>
          <div class="post-header">
            <nav class="breadcrumb" aria-label="Ruta">
              <a href="/blog/">Artículos</a> <span aria-hidden="true">/</span>
            </nav>
            <div class="post-date">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <span class="updated">· Actualizado: <FormattedDate date={updatedDate} /></span>
              )}
              {readingTime && <span>· {readingTime} min de lectura</span>}
            </div>
            <h1>{title}</h1>
            <p class="post-description">{description}</p>
            {tags && (
              <div class="tags">
                {tags.map((tag: string) => <a class="tag" href={`/etiquetas/${tagSlug(tag)}/`}>{tag}</a>)}
              </div>
            )}
            <hr />
          </div>
          {heroImage && <Image class="hero-image" src={heroImage} alt="" widths={[720, 1440]} sizes="(max-width: 760px) 100vw, 720px" loading="eager" />}
          <div class="prose" id="post-content">
            <slot />
          </div>
          <aside class="author-box" aria-label="Sobre el autor">
            <div class="avatar" aria-hidden="true">JL</div>
            <div>
              <p class="author-name">{SITE.author}</p>
              <p>Administrador de sistemas y redes en Albacete, especializado en ciberseguridad. Documento aquí lo que monto en mi homelab.</p>
              <p class="author-links">
                <a href="/about/">Sobre mí</a> · <a href={SITE.web}>jelopez.link</a> · <a href={SITE.linkedin} rel="noopener">LinkedIn</a>
              </p>
            </div>
          </aside>
          {(newer || older) && (
            <nav class="post-nav" aria-label="Más artículos">
              {older ? (
                <a href={older.href} class="prev"><span>← Anterior</span>{older.title}</a>
              ) : <span />}
              {newer && (
                <a href={newer.href} class="next"><span>Siguiente →</span>{newer.title}</a>
              )}
            </nav>
          )}
          <Comments />
        </article>
        {toc.length > 2 && (
          <aside class="toc" aria-label="Tabla de contenidos">
            <p class="toc-title">En esta página</p>
            <ul>
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'sub' : undefined}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>

<script>
  // Barra de progreso de lectura
  const bar = document.getElementById('progress');
  function updateProgress() {
    if (!bar) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // Enlaces ancla en h2/h3 y botón "copiar" en los bloques de código
  document.querySelectorAll<HTMLElement>('#post-content :is(h2, h3)[id]').forEach((h) => {
    const a = document.createElement('a');
    a.href = `#${h.id}`;
    a.className = 'heading-anchor';
    a.textContent = '#';
    a.setAttribute('aria-label', 'Enlace a esta sección');
    h.prepend(a);
  });

  document.querySelectorAll<HTMLElement>('#post-content pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copiar';
    pre.appendChild(btn);
  });

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy-btn');
    if (!btn) return;
    const code = btn.parentElement?.querySelector('code')?.innerText ?? '';
    try {
      await navigator.clipboard.writeText(code);
      btn.textContent = 'Copiado';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = 'Copiar';
        btn.classList.remove('copied');
      }, 1800);
    } catch {
      btn.textContent = 'Error';
    }
  });
</script>

<style>
  main {
    max-width: 1080px;
  }

  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 300;
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 720px) 220px;
    gap: 3.5rem;
    justify-content: center;
  }

  article { min-width: 0; }

  .post-header { margin-bottom: 2rem; }

  .post-date {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .post-date time { font-family: var(--font-mono); }

  h1 {
    font-size: 2.4rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .post-description {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }

  .breadcrumb { font-size: 0.82rem; margin-bottom: 0.5rem; color: var(--text-muted); }

  .tag {
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    background: var(--surface-hover);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }


  .tag:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }

  hr { margin: 1.75rem 0 2rem; }

  .hero-image { width: 100%; margin-bottom: 2rem; }

  .author-box {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin-top: 3rem;
    padding: 1.4rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: linear-gradient(135deg, #ff6d71, #6d4aff);
    font-family: var(--font-heading);
    font-weight: 800;
    color: #fff;
  }

  .author-box p { font-size: 0.9rem; margin-bottom: 0.4rem; }
  .author-box .author-name { font-weight: 600; color: var(--text); margin-bottom: 0.2rem; }
  .author-box .author-links { margin: 0; font-size: 0.85rem; color: var(--text-muted); }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  .post-nav a {
    display: block;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    color: var(--text);
    font-weight: 500;
    font-size: 0.92rem;
    line-height: 1.45;
    transition: border-color 0.2s, background 0.2s;
  }

  .post-nav a:hover { border-color: var(--accent); background: var(--surface-hover); text-decoration: none; }
  .post-nav span { display: block; font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono); margin-bottom: 0.3rem; }
  .post-nav .next { text-align: right; }

  .prose { font-size: 1rem; line-height: 1.8; }

  /* Tabla de contenidos */
  .toc {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    font-size: 0.82rem;
  }

  .toc-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .toc ul {
    list-style: none;
    padding: 0 0 0 0.9rem;
    margin: 0;
    border-left: 1px solid var(--border);
  }

  .toc li { margin: 0 0 0.45rem; line-height: 1.4; }
  .toc li.sub { padding-left: 0.8rem; }

  .toc a { color: var(--text-muted); transition: color 0.15s; }
  .toc a:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 1100px) {
    .post-layout { grid-template-columns: minmax(0, 720px); }
    .toc { display: none; }
  }

  @media (max-width: 640px) {
    h1 { font-size: 1.7rem; }
    .post-nav { grid-template-columns: 1fr; }
    .post-nav .next { text-align: left; }
  }
</style>
