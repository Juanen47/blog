---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { countTags, getPosts } from '../../utils';

const tags = countTags(await getPosts());
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title="Temas · blog.jelopez.link" description="Todos los temas del blog: Proxmox, redes, seguridad, Cloudflare, WireGuard, DNS y más." />
  </head>
  <body>
    <Header />
    <main id="main">
      <header class="page-head">
        <h1>Temas</h1>
        <p>Los artículos agrupados por etiqueta. El número indica cuántos hay de cada una.</p>
      </header>
      <ul class="tag-cloud">
        {tags.map((t) => (
          <li><a class="tag" href={`/etiquetas/${t.slug}/`}>{t.tag} <span>{t.count}</span></a></li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>

<style>
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; }
  .tag-cloud .tag { font-size: 1rem; padding: 0.4rem 0.85rem; }
  .tag-cloud span { color: var(--muted); margin-left: 0.25rem; font-variant-numeric: tabular-nums; }
</style>
