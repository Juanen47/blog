---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../utils';

const posts = (await getPosts()).slice(0, 3);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title="Página no encontrada · blog.jelopez.link" description="Esta página no existe." noindex />
  </head>
  <body>
    <Header />
    <main id="main">
      <section class="page-head">
        <h1>Esta página no existe<span class="dot">.</span></h1>
        <p>Puede que el enlace esté mal escrito o que el artículo haya cambiado de dirección. Prueba con la <a href="/blog/">lista de artículos</a> o las <a href="/etiquetas/">etiquetas</a>.</p>
      </section>
      <h2 class="section-head">Artículos recientes</h2>
      <PostList posts={posts} headingLevel="h3" />
    </main>
    <Footer />
  </body>
</html>

<style>
  .dot { color: var(--accent); }
</style>
