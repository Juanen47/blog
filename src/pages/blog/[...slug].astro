---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, readingTime } from '../../utils';

export async function getStaticPaths() {
	const posts = await getPosts();
	// posts va del más reciente al más antiguo: "siguiente" es el más nuevo.
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	newer?: CollectionEntry<'blog'>;
	older?: CollectionEntry<'blog'>;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost
	{...post.data}
	headings={headings}
	readingTime={readingTime(post.body)}
	wordCount={(post.body ?? '').split(/\s+/).filter(Boolean).length}
	newer={newer && { href: `/blog/${newer.id}/`, title: newer.data.title }}
	older={older && { href: `/blog/${older.id}/`, title: older.data.title }}
>
	<Content />
</BlogPost>
