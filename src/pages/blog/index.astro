---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { countTags, getPosts } from '../../utils';

const posts = await getPosts();
const tags = countTags(posts);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title="Todos los artículos · blog.jelopez.link" description={`Los ${posts.length} artículos del blog: Proxmox, redes, Cloudflare Tunnel, WireGuard, DNS, MFA, monitorización y hardening de un homelab real.`} />
  </head>
  <body>
    <Header />
    <main id="main">
      <header class="page-head">
        <h1>Artículos</h1>
        <p>Documentación técnica del homelab: Proxmox, redes, servicios self-hosted y seguridad. {posts.length} artículos, del más reciente al más antiguo.</p>
        <ul class="filter" aria-label="Filtrar por tema">
          {tags.slice(0, 8).map((t) => <li><a class="tag" href={`/etiquetas/${t.slug}/`}>{t.tag}</a></li>)}
          <li><a class="tag all" href="/etiquetas/">Todos los temas</a></li>
        </ul>
      </header>
      <PostList posts={posts} />
    </main>
    <Footer />
  </body>
</html>

<style>
  .filter { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin-top: 1.5rem; }
  .filter .all { border-style: dashed; }
</style>
