---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { AUTHOR_LD, SITE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { countTags, getPosts, readingTime, tagSlug, formatDate, seriesPosts, SERIES_SLUGS } from '../utils';

const posts = await getPosts();
const tags = countTags(posts).slice(0, 14);
const [latest, ...rest] = posts;
const featured = posts.find((p) => p.data.featured);
const seriesName = 'El homelab desde cero';
const series = seriesPosts(posts, seriesName);
const seriesMinutes = series.reduce((m, p) => m + readingTime(p.body), 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE.url}/#blog`,
  name: SITE.name,
  url: `${SITE.url}/`,
  description: SITE_DESCRIPTION,
  inLanguage: 'es-ES',
  author: AUTHOR_LD,
  blogPost: posts.slice(0, 10).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `${SITE.url}/blog/${p.id}/`,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} jsonLd={jsonLd} />
  </head>
  <body>
    <Header />
    <main id="main">
      <section class="hero">
        <h1>Documentando mi homelab, paso a paso.</h1>
        <p class="lead">Soy <a href="/about/">Juanen</a>, administrador de sistemas y redes. Aquí cuento cómo monto y aseguro mi homelab: Proxmox, redes, servicios self-hosted y hardening, con la configuración real y los errores incluidos.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/blog/">Ver todos los artículos</a>
          <a class="btn" href="/about/">Sobre mí</a>
        </div>
        <dl class="facts" aria-label="El homelab en cifras">
          <div><dt>Artículos</dt><dd>{posts.length}</dd></div>
          <div><dt>Puertos abiertos en el router</dt><dd>1<small>, el de la VPN</small></dd></div>
          <div><dt>Copia de seguridad</dt><dd>Cada noche</dd></div>
        </dl>
      </section>

      {featured && (
        <section class="start" aria-labelledby="start-title">
          <h2 class="section-head" id="start-title">Empieza por aquí</h2>
          <div class="start-grid">
            <article class="feature">
              <p class="feature-meta">
                <span>Visión general</span>
                <span>{readingTime(featured.body)} min de lectura</span>
              </p>
              <h3><a href={`/blog/${featured.id}/`}>{featured.data.title}</a></h3>
              <p class="feature-desc">{featured.data.description}</p>
            </article>
            <nav class="series-card" aria-labelledby="series-title">
              <h3 id="series-title"><a href={`/serie/${SERIES_SLUGS[seriesName]}/`}>{seriesName}</a></h3>
              <p>{series.length} artículos en orden, del hardware al panel propio. Unos {seriesMinutes} minutos de lectura en total.</p>
              <ol>
                {series.slice(0, 5).map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}
              </ol>
              <a class="more" href={`/serie/${SERIES_SLUGS[seriesName]}/`}>Ver los {series.length} artículos de la serie</a>
            </nav>
          </div>
        </section>
      )}

      {latest && (
        <section class="latest" aria-labelledby="latest-title">
          <h2 class="section-head" id="latest-title">Último artículo</h2>
          <article class="feature">
            <p class="feature-meta">
              <time datetime={latest.data.pubDate.toISOString()}>{formatDate(latest.data.pubDate)}</time>
              <span>{readingTime(latest.body)} min de lectura</span>
            </p>
            <h3><a href={`/blog/${latest.id}/`} style={`view-transition-name: t-${latest.id}`}>{latest.data.title}</a></h3>
            <p class="feature-desc">{latest.data.description}</p>
            {latest.data.tags && (
              <ul class="feature-tags" aria-label="Etiquetas">
                {latest.data.tags.map((t: string) => <li><a class="tag" href={`/etiquetas/${tagSlug(t)}/`}>{t}</a></li>)}
              </ul>
            )}
          </article>
        </section>
      )}

      <section class="recent" aria-labelledby="recent-title">
        <h2 class="section-head" id="recent-title">Anteriores</h2>
        <PostList posts={rest.slice(0, 5)} headingLevel="h3" />
        {rest.length > 5 && <a class="more" href="/blog/">Ver los {posts.length} artículos</a>}
      </section>

      <section class="topics" aria-labelledby="topics-title">
        <h2 class="section-head" id="topics-title">Temas</h2>
        <ul class="topic-list">
          {tags.map((t) => (
            <li><a class="tag" href={`/etiquetas/${t.slug}/`}>{t.tag} <span>{t.count}</span></a></li>
          ))}
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .hero { padding: clamp(1.5rem, 5vw, 3.5rem) 0 clamp(3rem, 6vw, 4.5rem); max-width: 52rem; }

  .hero h1 {
    font-size: clamp(2.3rem, 6.4vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-bottom: 1.5rem;
  }

  .lead {
    font-size: clamp(1.08rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    max-width: 40rem;
    margin-bottom: 2rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 2.75rem;
    max-width: 44rem;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }

  .facts div { background: var(--bg-raised); padding: 0.9rem 1.1rem; }
  .facts dt { font-size: 0.8rem; font-weight: 600; color: var(--muted); }
  .facts dd { font-size: 1.5rem; font-weight: 800; font-stretch: var(--wide); letter-spacing: -0.02em; margin-top: 0.15rem; }
  .facts small { font-size: 0.85rem; font-weight: 500; font-stretch: 100%; letter-spacing: 0; color: var(--muted); }

  @media (prefers-reduced-motion: no-preference) {
    .hero > * { animation: rise 0.8s var(--ease-out) both; }
    .hero > :nth-child(2) { animation-delay: 0.06s; }
    .hero > :nth-child(3) { animation-delay: 0.12s; }
    .hero > :nth-child(4) { animation-delay: 0.18s; }
  }

  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  .start-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 1rem; align-items: stretch; }
  .series-card {
    padding: clamp(1.2rem, 2.6vw, 1.8rem);
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .series-card h3 { font-size: 1.25rem; font-stretch: var(--wide); margin-bottom: 0.5rem; }
  .series-card h3 a { color: var(--text); text-decoration: none; }
  .series-card h3 a:hover { color: var(--accent); }
  .series-card > p { font-size: 0.95rem; color: var(--text-2); }
  .series-card ol { margin: 1rem 0 0; padding-left: 1.4rem; display: grid; gap: 0.35rem; font-size: 0.95rem; }
  .series-card li::marker { color: var(--muted); font-variant-numeric: tabular-nums; }
  .series-card ol a { color: var(--text-2); text-decoration: none; }
  .series-card ol a:hover { color: var(--accent); }
  @media (max-width: 860px) { .start-grid { grid-template-columns: 1fr; } }

  .start, .latest, .recent, .topics { margin-top: clamp(2.5rem, 5vw, 3.5rem); }

  .feature {
    position: relative;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow);
    transition: border-color 0.25s;
  }

  .feature:hover { border-color: var(--line-strong); }

  .feature-meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font-size: 0.88rem; color: var(--muted); margin-bottom: 0.75rem; }

  .feature h3 {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: -0.025em;
    line-height: 1.1;
    max-width: 30ch;
    margin-bottom: 0.85rem;
  }

  .feature h3 a { color: var(--text); text-decoration: none; transition: color 0.2s; }
  .feature h3 a::after { content: ''; position: absolute; inset: 0; }
  .feature:hover h3 a { color: var(--accent); }

  .feature-desc { font-size: 1.05rem; max-width: 60ch; }

  .feature-tags, .topic-list { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; }
  .feature-tags { margin-top: 1.25rem; }
  .feature-tags a { position: relative; z-index: 1; }

  .more { display: inline-block; margin-top: 1.25rem; font-weight: 600; }

  .topic-list .tag { font-size: 0.9rem; padding: 0.3rem 0.7rem; }
  .topic-list span { color: var(--muted); margin-left: 0.2rem; font-variant-numeric: tabular-nums; }

  @media (max-width: 640px) {
    .facts { grid-template-columns: 1fr; }
    .facts div { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
    .facts dd { font-size: 1.15rem; text-align: right; }
  }
</style>
