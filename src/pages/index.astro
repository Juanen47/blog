---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { AUTHOR_LD, SITE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { countTags, getPosts } from '../utils';

const posts = await getPosts();
const tags = countTags(posts).slice(0, 12);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE.url}/#blog`,
  name: SITE.name,
  url: `${SITE.url}/`,
  description: SITE_DESCRIPTION,
  inLanguage: 'es-ES',
  author: AUTHOR_LD,
  blogPost: posts.slice(0, 10).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `${SITE.url}/blog/${p.id}/`,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} jsonLd={jsonLd} />
  </head>
  <body>
    <Header />
    <main id="main">
      <section class="hero">
        <p class="eyebrow">Homelab · Self-hosting · Seguridad</p>
        <h1>Documentando mi <span>homelab</span>, paso a paso.</h1>
        <p class="lead">Soy <a href="/about/">Juanen</a>, administrador de sistemas y redes. Aquí cuento cómo monto y aseguro mi homelab: Proxmox, redes, servicios self-hosted y hardening, con la configuración real y los errores incluidos.</p>
        <div class="hero-actions">
          <a class="btn primary" href="/blog/">Ver todos los artículos</a>
          <a class="btn" href="/about/">Sobre mí</a>
        </div>
        <ul class="stats" aria-label="El homelab en cifras">
          <li><strong>{posts.length}</strong> artículos</li>
          <li><strong>0</strong> puertos web abiertos</li>
          <li><strong>MFA</strong> en lo expuesto</li>
        </ul>
      </section>

      <h2 class="section-title">Últimos artículos</h2>
      <PostList posts={posts.slice(0, 5)} />
      {posts.length > 5 && <a class="more" href="/blog/">Ver los {posts.length} artículos →</a>}

      <h2 class="section-title topics">Temas</h2>
      <ul class="topic-list">
        {tags.map((t) => (
          <li><a href={`/etiquetas/${t.slug}/`}>{t.tag} <span>{t.count}</span></a></li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>

<style>
  .hero { padding: 3rem 0 3.5rem; }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .hero h1 {
    font-size: clamp(1.7rem, 6.6vw, 3.4rem);
    font-weight: 800;
    line-height: 1.08;
    margin-bottom: 1.25rem;
  }

  .hero h1 span { color: var(--accent); }

  .lead {
    font-size: 1.1rem;
    max-width: 560px;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .btn {
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
    transition: border-color 0.2s, background 0.2s;
  }

  .btn:hover { text-decoration: none; border-color: var(--accent); background: var(--accent-soft); }

  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn.primary:hover { background: var(--accent); filter: brightness(1.1); }

  .section-title {
    font-size: 0.85rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }

  .more { display: inline-block; margin-top: 1.5rem; font-size: 0.92rem; }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .stats li { margin: 0; }
  .stats strong { font-family: var(--font-mono); color: var(--text); margin-right: 0.3rem; }

  .topics { margin-top: 3.5rem; }

  .topic-list { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; }
  .topic-list li { margin: 0; }

  .topic-list a {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-2);
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    transition: border-color 0.2s, color 0.2s;
  }

  .topic-list a:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
  .topic-list span { color: var(--text-muted); margin-left: 0.25rem; }
</style>
