---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { AUTHOR_LD, SITE } from '../../consts';
import { getPosts, readingTime, seriesPosts, SERIES_SLUGS } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return Object.entries(SERIES_SLUGS).map(([name, slug]) => ({
    params: { slug },
    props: { name, parts: seriesPosts(posts, name) },
  }));
}

const { name, parts } = Astro.props;
const minutes = parts.reduce((m, p) => m + readingTime(p.body), 0);
const url = new URL(Astro.url.pathname, Astro.site).href;
const description = `Serie de ${parts.length} artículos para montar un homelab seguro con Proxmox, en orden: hardware, red, VPN, DNS, proxy inverso, vigilancia, bastionado, nube, multimedia y un panel propio.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWorkSeries',
  name,
  url,
  description,
  inLanguage: 'es-ES',
  author: AUTHOR_LD,
  hasPart: parts.map((p, i) => ({
    '@type': 'BlogPosting',
    position: i + 1,
    headline: p.data.title,
    url: `${SITE.url}/blog/${p.id}/`,
  })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`${name} · serie · blog.jelopez.link`} description={description} jsonLd={jsonLd} />
  </head>
  <body>
    <Header />
    <main id="main">
      <header class="page-head">
        <h1>{name}</h1>
        <p>{description} En total, unos {minutes} minutos de lectura.</p>
      </header>
      <ol class="parts">
        {parts.map((p) => (
          <li>
            <h2><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
            <p>{p.data.description}</p>
            <p class="meta"><FormattedDate date={p.data.pubDate} /> · {readingTime(p.body)} min de lectura</p>
          </li>
        ))}
      </ol>
    </main>
    <Footer />
  </body>
</html>

<style>
  .parts { list-style: none; counter-reset: part; padding: 0; margin: 2rem 0 0; max-width: 46rem; }
  .parts li {
    counter-increment: part;
    position: relative;
    padding: 1.25rem 0 1.4rem 3.4rem;
    border-top: 1px solid var(--line);
  }
  .parts li::before {
    content: counter(part);
    position: absolute;
    left: 0;
    top: 1.2rem;
    width: 2.3rem;
    height: 2.3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .parts li:first-child::before { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .parts h2 { font-size: 1.15rem; line-height: 1.3; margin-bottom: 0.35rem; }
  .parts h2 a { color: var(--text); text-decoration: none; }
  .parts h2 a:hover { color: var(--accent); }
  .parts p { font-size: 0.95rem; color: var(--text-2); }
  .parts .meta { font-size: 0.85rem; color: var(--muted); margin-top: 0.35rem; }
</style>
